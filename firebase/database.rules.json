{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userIdMap": {
      ".read": "auth != null",
      "$dryChatId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || newData.child('uid').val() === auth.uid)"
      }
    },
    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (!data.exists() || data.child('members/' + auth.uid).exists())",
        ".write": "auth != null && (data.child('members/' + auth.uid).exists() || newData.child('members/' + auth.uid).exists() || !data.exists())"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null"
        }
      }
    },
    "inboxes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$messageId": {
          ".write": "auth != null"
        }
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null"
        }
      }
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null && data.child('members/' + auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child('members/' + auth.uid + '/role').val() === 'owner' || data.child('members/' + auth.uid + '/role').val() === 'admin')"
      }
    }
  }
}
